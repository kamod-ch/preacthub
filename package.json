{
  "name": "preacthub",
  "private": true,
  "type": "module",
  "author": "Klaus Zahiragic <watzak>",
  "scripts": {
    "dev": "preactpress dev",
    "check": "preactpress check",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "check:links": "tsx scripts/check-library-links.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "migrate:catalog": "tsx scripts/migrate-library-catalog.ts",
    "deploy:all-inkl": "bash scripts/deploy-all-inkl.sh",
    "deploy:all-inkl:ftps": "bash scripts/deploy-all-inkl-ftps.sh",
    "build": "npm run validate:catalog && preactpress build && npm run verify:seo",
    "preview": "preactpress preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint . --ignore-pattern node_modules --ignore-pattern dist",
    "new:library": "node scripts/new-library.mjs",
    "new:category": "node scripts/new-category.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "import:parse-candidates": "node scripts/parse-preacthub-candidates.mjs",
    "import:merge-drafts": "node scripts/merge-catalog-drafts.mjs",
    "import:candidates": "node scripts/import-library-candidates.mjs",
    "prepare:audit": "npm run build --prefix ../kamod-ai-audit/packages/core",
    "audit:site": "node scripts/audit-site.mjs",
    "audit:site:report": "node scripts/audit-site.mjs --output reports/audit"
  },
  "dependencies": {
    "@kamod-ch/themes": "^0.2.1",
    "@kamod-ch/ui": "^1.0.1",
    "@preact/signals": "^2.9.4",
    "gray-matter": "^4.0.3",
    "preact": "^10.29.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kamod-ch/preactpress": "^2.2.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
